# ─────────────────────────────────────────────────────────────────────────────
# KAIRON — Environment Configuration
# Copy this file to .env and fill in your values.
# Zero required keys — the system runs fully on defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider (choose one) ─────────────────────────────────────────────────
LLM_PROVIDER=ollama                        # ollama | openai | anthropic
LLM_MODEL=llama3.2                         # model name for the chosen provider
OPENAI_API_KEY=                            # optional — openai.com
ANTHROPIC_API_KEY=                         # optional — anthropic.com
OLLAMA_BASE_URL=http://localhost:11434      # default ollama endpoint

# ── Market Data (all optional — Yahoo Finance works without keys) ─────────────
FRED_API_KEY=                              # free — fred.stlouisfed.org
BRAVE_SEARCH_API_KEY=                      # free 2000/mo — api.search.brave.com
SERPER_API_KEY=                            # free 2500/mo — serper.dev (optional)

# ── Social Sentiment (optional) ───────────────────────────────────────────────
REDDIT_CLIENT_ID=                          # free — reddit.com/prefs/apps
REDDIT_CLIENT_SECRET=                      # same registration
REDDIT_USER_AGENT=kairon/1.0

# ── Portfolio Simulation ──────────────────────────────────────────────────────
PORTFOLIO_CAPITAL=100000                   # simulated starting capital USD
BASE_CURRENCY=USD
MAX_POSITION_PCT=0.25                      # max 25% in any single asset
MAX_DRAWDOWN_PCT=0.10                      # halt new trades if portfolio -10%
MIN_NET_PROFIT_PCT=0.005                   # only move if net profit > 0.5%

# ── Tax Rates (US federal defaults — override for your jurisdiction) ──────────
TAX_REGION=US
SHORT_TERM_TAX_RATE=0.37
LONG_TERM_TAX_RATE=0.20
TAX_YEAR_DAYS=365
STATE_TAX_RATE=0.05                        # 0.0 for TX, FL, WA, NV

# ── Infrastructure ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///kairon.db
REDIS_URL=redis://localhost:6379           # optional — falls back to in-memory cache
LOG_LEVEL=INFO
DATA_REFRESH_INTERVAL_MINUTES=15
OUTCOME_CHECK_HOUR=6                       # UTC hour for daily outcome recording

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_FINBERT=false                       # set true if PyTorch available
ENABLE_CHROMADB=false                      # set true if chromadb installed
ENABLE_REDIS=false                         # set true if Redis running
FIRST_RUN=true                             # cleared automatically after wizard
